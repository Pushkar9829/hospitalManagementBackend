{
  "name": "@hms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:worker": "node --watch --env-file-if-exists=.env src/worker.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "seed:dev": "node --env-file-if-exists=.env scripts/seed-dev.js",
    "sync:roles": "node --env-file-if-exists=.env scripts/sync-system-roles.js",
    "lint": "eslint .",
    "test": "vitest run --project unit && npm run test --workspace @hms/shared",
    "test:int": "vitest run --project integration",
    "platform:admin": "node --env-file-if-exists=.env scripts/create-platform-admin.js",
    "catalog": "node packages/shared/scripts/gen-catalog.js",
    "format": "prettier --write .",
    "format:check": "prettier --check . --end-of-line auto",
    "seed:atlas": "node --env-file=.env --env-file=.env.atlas scripts/seed-dev.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@hms/shared": "0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.5",
    "bwip-js": "4.11.4",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "otplib": "^12.0.1",
    "pdfmake": "0.2.23",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
