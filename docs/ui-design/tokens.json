{
  "font": {
    "ui": "IBM Plex Sans",
    "mono": "IBM Plex Mono"
  },
  "radius": {
    "chip": 999,
    "control": 8,
    "card": 10,
    "dialog": 12
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    28,
    48
  ],
  "touchTarget": 44,
  "menuWidth": 232,
  "colors": {
    "color.ground": {
      "value": "#F4F6F8",
      "mui": "palette.background.default",
      "use": "Page background"
    },
    "color.surface": {
      "value": "#FFFFFF",
      "mui": "palette.background.paper",
      "use": "Cards, tables, dialogs"
    },
    "color.ink": {
      "value": "#142130",
      "mui": "palette.text.primary",
      "use": "Body text"
    },
    "color.muted": {
      "value": "#5B6878",
      "mui": "palette.text.secondary",
      "use": "Captions, hints"
    },
    "color.line": {
      "value": "#DDE2E8",
      "mui": "palette.divider",
      "use": "Borders, table rules"
    },
    "color.menu": {
      "value": "#13263F",
      "mui": "custom.menu.bg",
      "use": "Side menu background"
    },
    "color.primary": {
      "value": "#1D3557",
      "mui": "palette.primary.main",
      "use": "Primary buttons, bars"
    },
    "color.accent": {
      "value": "#B4501A",
      "mui": "palette.secondary.main",
      "use": "Logo, active marker, highlights"
    },
    "color.success": {
      "value": "#1A6B44",
      "mui": "palette.success.dark",
      "use": "Paid, available, done (on #E3F3EA)"
    },
    "color.warning": {
      "value": "#7A4E00",
      "mui": "palette.warning.dark",
      "use": "Pending, approval (on #FFF1D6)"
    },
    "color.critical": {
      "value": "#A3201A",
      "mui": "palette.error.dark",
      "use": "Critical, occupied, rejected (on #FDECEA)"
    },
    "color.info": {
      "value": "#1F5FAD",
      "mui": "palette.info.dark",
      "use": "Booked, in progress (on #E6EEF9)"
    },
    "color.due": {
      "value": "#9A4413",
      "mui": "custom.due",
      "use": "Due today, discharge due (on #FCE9DC)"
    },
    "color.neutral": {
      "value": "#3F4A57",
      "mui": "custom.neutral",
      "use": "Draft, inactive (on #EEF0F3)"
    },
    "color.selected": {
      "value": "#E6EEF9",
      "mui": "action.selected",
      "use": "Selected row or item"
    },
    "focus.ring": {
      "value": "#1F5FAD",
      "mui": "custom.focus",
      "use": "2 px outline, 2 px offset"
    }
  }
}
