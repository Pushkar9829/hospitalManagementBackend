# Copy to api/.env for local development. On Render, set these in the service environment.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/hms?replicaSet=rs0
REDIS_URL=redis://localhost:6379
# Hospital sub-domains resolve under this root: demo.localhost -> tenant "demo".
ROOT_DOMAIN=localhost
# Proxy hops in front of the API: 0 locally, 2 in production (CloudFront -> ALB).
TRUST_PROXY=0
# RS256 key pair (PEM, \n-escaped) and a 32-byte base64 data key. Leave empty in development:
# the API generates them into api/.keys/ (git-ignored). Required in production.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MIN=15
# Refresh token lifetime with "remember this device", and without it.
REFRESH_TOKEN_TTL_DAYS=7
SESSION_TTL_HOURS=12
IDLE_TIMEOUT_MIN=15
SMS_PROVIDER=console
AWS_REGION=ap-south-1
S3_DOCS_BUCKET=
LOG_LEVEL=info
# Swagger UI at /api/docs (default: on outside production).
ENABLE_API_DOCS=true
# Hospital web address for links in SMS ({subdomain} is replaced).
WEB_URL_TEMPLATE=http://{subdomain}.localhost:5173

# SaaS platform (signup, platform invoices, console)
PLATFORM_LEGAL_NAME=HMS Cloud Private Limited
PLATFORM_GSTIN=
PLATFORM_STATE=Maharashtra
# Razorpay webhook secret (Dashboard > Webhooks); payments are rejected without it
RAZORPAY_WEBHOOK_SECRET=
# Only for scripts/create-platform-admin.js (pnpm --filter @hms/api platform:admin <email> "<name>")
# PLATFORM_ADMIN_PASSWORD=

# Hosting without S3 or a separate worker (Render): files in MongoDB, jobs inside the API.
# STORAGE_DRIVER=mongo
# RUN_WORKER=true
# Serve one hospital on an address that matches none (e.g. a vercel.app demo).
# DEFAULT_TENANT=demo
